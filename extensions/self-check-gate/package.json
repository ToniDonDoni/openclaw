{
  "name": "@openclaw/self-check-gate",
  "version": "2026.4.9",
  "private": true,
  "description": "OpenClaw self-check gate plugin for session-scoped followup validation",
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*",
    "openclaw": "workspace:*"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.9"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@openclaw/self-check-gate",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.9"
    },
    "compat": {
      "pluginApi": ">=2026.4.9"
    }
  }
}
